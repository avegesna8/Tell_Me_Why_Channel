OPENAI_API_KEY=
OPENAI_PLAN_MODEL=gpt-4.1-mini
# Optional script reviewer; defaults to OPENAI_PLAN_MODEL to minimize cost.
OPENAI_REVIEW_MODEL=
# Optional paid web grounding for the single review call; disabled by default.
SCRIPT_WEB_FACT_CHECK=0
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Optional; defaults to the project's characters/updated_base.png when present.
IMAGE_REFERENCE=characters/updated_base.png
TTS_PROVIDER=runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Path to a short, clean reference speech recording (WAV recommended).
RUNPOD_REFERENCE_AUDIO=
# Optional legacy provider: use TTS_PROVIDER=siliconflow to enable the settings below.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE=https://api.siliconflow.com
INDEXTTS_MODEL=IndexTeam/IndexTTS-2
# Required: a model-qualified built-in voice or the speech: URI returned by POST /voices.
SILICONFLOW_VOICE=

# Optional approved music/effects catalog; omit for narration only.
AUDIO_LIBRARY=audio/library.json
